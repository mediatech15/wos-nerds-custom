{
  "name": "wos-index",
  "version": "1.0.0",
  "description": "WOS Nerds Website",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/css/tailwind.css -o ./src/css/built/tailwind.css",
    "watch:css": "npx tailwindcss -i ./src/css/tailwind.css -o ./src/css/built/tailwind.css --watch",
    "build": "npm run build:css & parcel build --no-source-maps",
    "build:ci": "npm install --include-dev && npm run build:css & parcel build --no-source-maps",
    "serve": "parcel serve -p 5500 --host localhost --watch-dir src --no-cors",
    "build:browserslist": "npx update-browserslist-db@latest"
  },
  "devDependencies": {
    "browserslist": "^4.28.1",
    "caniuse-lite": "^1.0.30001781",
    "parcel": "^2.16.4",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "standard": "^17.1.2",
    "tailwindcss": "^3.4.17"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "source": [
    "src/index.html",
    "src/navbar.html"
  ],
  "targets": {
    "default": {
      "context": "browser",
      "distDir": "./dist",
      "outputFormat": "esmodule",
      "sourceMap": true,
      "includeNodeModules": false
    }
  },
  "staticFiles": [
    {
      "staticPath": "src/config.json"
    }
  ],
  "browserslist": [
    "defaults"
  ],
  "standard": {
    "global": []
  }
}